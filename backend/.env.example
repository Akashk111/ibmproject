# MANGALURU BUS CONNECT — BACKEND ENVIRONMENT CONFIGURATION
# Copy to .env and fill in your actual merchant keys and database credentials

PORT=5001
SECRET_KEY=mangaluru-bus-connect-super-secret-key-2026
JWT_SECRET=jwt-secret-mangaluru-city-transit-super-secure
DATABASE_URL=sqlite:///mangaluru_bus.db

# OFFICIAL PAYTM PAYMENT GATEWAY INTEGRATION
# Documentation: https://business.paytm.com/docs/
PAYTM_MID=YOUR_PAYTM_MERCHANT_ID_HERE
PAYTM_MERCHANT_KEY=YOUR_PAYTM_MERCHANT_KEY_HERE
PAYTM_WEBSITE=WEBSTAGING
PAYTM_ENVIRONMENT=sandbox
PAYTM_CHANNEL_ID=WEB
PAYTM_INDUSTRY_TYPE_ID=Retail
PAYTM_CALLBACK_URL=http://localhost:5001/api/payments/callback

# AUTOMATIC SMS BOOKING CONFIRMATION (MSG91 / Twilio)
# Provider options: 'TEST_MODE' (default), 'MSG91', 'TWILIO'
SMS_PROVIDER=TEST_MODE
SMS_PROVIDER_API_KEY=YOUR_SMS_API_KEY_HERE
SMS_SENDER_ID=MNGBUS
MSG91_FLOW_ID=YOUR_MSG91_TEMPLATE_FLOW_ID
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=YOUR_TWILIO_PHONE_NUMBER

# AUTOMATIC EMAIL BOOKING CONFIRMATION (Resend / SendGrid / SMTP)
# Provider options: 'TEST_MODE' (default), 'RESEND', 'SENDGRID', 'SMTP'
EMAIL_PROVIDER=TEST_MODE
EMAIL_API_KEY=YOUR_EMAIL_API_KEY_HERE
EMAIL_FROM=bookings@mangaluru-bus.in
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_GMAIL_USERNAME
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# TEST MODE (Keep true to safely simulate SMS and Email without sending real messages)
NOTIFICATION_TEST_MODE=true
