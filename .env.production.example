# ==========================================
# Mangaluru Bus Connect - Production Environment
# ==========================================

# 1. Frontend Environment Variables (Vercel)
# Set this in Vercel Project Settings > Environment Variables
# If deploying backend to Render/Railway:
VITE_API_URL=https://mangaluru-bus-backend.onrender.com

# 2. Backend Environment Variables (Render / Railway / Vercel Serverless)
FLASK_DEBUG=false
SECRET_KEY=replace-with-a-random-32-char-secret-string
JWT_SECRET=replace-with-a-random-32-char-jwt-secret
JWT_EXPIRY_HOURS=72

# Database (optional for PostgreSQL; falls back to SQLite automatically)
# DATABASE_URL=postgresql://user:password@host:5432/mangaluru_bus

# Notifications & Paytm Sandbox
PAYTM_ENV=TEST
PAYTM_MID=YOUR_SANDBOX_MERCHANT_ID
PAYTM_MERCHANT_KEY=YOUR_SANDBOX_KEY
PAYTM_WEBSITE=WEBSTAGING
PAYTM_INDUSTRY_TYPE_ID=Retail
PAYTM_CHANNEL_ID=WEB

# SMS & Email Notifications
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=DKBOA
EMAIL_API_KEY=
EMAIL_FROM=notifications@mangaluru-bus.in
